# Add one provider key. The keys stay on the server and are never sent to the browser.
GEMINI_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=

# Optional model overrides. Defaults are multimodal models that can read images.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=qwen/qwen3.8-27b
SARVAM_MODEL=gemma4

# Local development only; Render sets PORT automatically.
PORT=3000
